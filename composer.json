{
  "name": "inxmail/magento2-module",
  "description": "Inxmail Magento 2 Module",
  "type": "magento2-module",
  "license": [
    "OSL-3.0"
  ],
  "authors": [
    {
      "name": "Peter Lelewel",
      "email": "peter.lelewel@flagbit.de",
      "role": "Developer"
    },
    {
      "name": "Björn Meyer",
      "email": "bjoern.meyer@flagbit.de",
      "role": "Projectmanager"
    }
  ],
  "repositories": [
    {
      "type": "composer",
      "url": "https://repo.magento.com/"
    }
  ],
  "require": {
    "php": "^8.1",
    "ext-json": "*",
    "magento/product-community-edition": "^2.4.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5 || ^12.0",
    "squizlabs/php_codesniffer": "3.*"
  },
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "Flagbit\\Inxmail\\": ""
    }
  },
  "config": {
    "sort-packages": true
  }
}
